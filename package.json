{
	"name": "dkuzeit",
	"private": true,
	"version": "1.0.0",
	"license": "MIT",
	"author": "Roman Kurakin",
	"type": "module",
	"packageManager": "pnpm@12.8.1",
	"scripts": {
		"dev": "vite dev",
		"preview": "vite build && wrangler dev",
		"preview:e2e": "vite build && wrangler dev --env e2e",
		"fixtures:serve": "tsx scripts/serve-fixtures.ts",
		"build": "svelte-kit sync && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker && eslint .",
		"fixtures:sync": "tsx scripts/download-fixtures.ts",
		"fixtures:parse": "tsx scripts/parse-fixtures.ts",
		"bench:parser": "tsx tests/bench-parser.ts",
		"test": "vitest run  --coverage",
		"test:e2e": "playwright test"
	},
	"engines": {
		"node": ">=22",
		"pnpm": ">=11"
	},
	"dependencies": {
		"@evilmartians/harmony": "^1.4.0",
		"@hackernoon/pixel-icon-library": "^1.1.0",
		"@sentry/sveltekit": "^11.2.0",
		"bits-ui": "^2.19.4",
		"domhandler": "^6.0.1",
		"htmlparser2": "^12.0.0",
		"is-network-error": "^1.3.2",
		"slugify": "^1.6.9",
		"svelte-sonner": "^1.2.1",
		"ts-ics": "^2.4.7"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.25.4",
		"@inlang/plugin-m-function-matcher": "^2.2.16",
		"@inlang/plugin-message-format": "^4.4.4",
		"@j178/prek": "^0.5.4",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"@vitest/coverage-v8": "^5.0.3",
		"@vitest/eslint-plugin": "^1.6.27",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"msw": "^3.0.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"wrangler": "^4.146.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
