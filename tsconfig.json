{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"sourceMap": true,
		"types": ["node", "vitest/globals", "$app/types"]
	},
	"include": ["src", "tests", "*"],
	"exclude": ["src/service-worker", "tests/fixtures"]
}
